# systemd unit for CashCast on a single small server behind nginx.
[Unit]
Description=CashCast key server
After=network-online.target
Wants=network-online.target

[Service]
User=cashcast
WorkingDirectory=/opt/cashcast
EnvironmentFile=/opt/cashcast/deploy/cashcast.env
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
RestartSec=5
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/cashcast

[Install]
WantedBy=multi-user.target
